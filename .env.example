# Local development environment variables

# -- Application Settings --
APP_ENV="development"
LOG_LEVEL="debug"

# -- Next.js Specific --
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -- Feature Flags (Optional - appConfig.ts has defaults) --
# These are client-side accessible due to NEXT_PUBLIC_ prefix
NEXT_PUBLIC_FEATURE_ADVANCED_KPI="false"
NEXT_PUBLIC_FEATURE_BADGE_SYSTEM="true"
NEXT_PUBLIC_FEATURE_USER_ACCOUNTS="true"

# -- API Configuration (Optional - appConfig.ts has defaults) --
# API_DEFAULT_TIMEOUT_MS="30000" # For internal APIs if any, or other external non-OpenAI APIs

# -- LLM Provider & Models (used by llm-clients) --
LLM_PROVIDER=ollama
LLM_MODEL_PRIMARY=gemma3:270m
LLM_MODEL_FALLBACK=gemma3:270m
LLM_TEMPERATURE="0.3"
LLM_MAX_TOKENS="2048"

# Ollama settings for local development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=90000
OLLAMA_RETRIES=4

# OpenAI settings
OPENAI_API_KEY=